# Production configuration
VERUNUM_ENV=production
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
VERUNUM_BOOTSTRAP_ADMIN_EMAIL=admin@example.com
VERUNUM_BOOTSTRAP_ADMIN_PASSWORD=replace-with-a-long-random-password
VERUNUM_BOOTSTRAP_ADMIN_NAME=Platform Administrator
VERUNUM_BOOTSTRAP_ORGANIZATION=Your Organisation

# Comma-separated browser origins allowed to use the device WebSocket.
# Hardware WebSocket clients normally send no Origin header.
VERUNUM_WS_ORIGINS=https://your-domain.example

# ClifeSMS (https://www.clife.shop) — attendance SMS notifications.
# Get the API key from your ClifeSMS API Console. Leave the placeholder to
# keep SMS delivery disabled (queued messages are marked sent without sending).
CLIFESMS_API_KEY=your-api-key-here
# Sender ID shown on recipients' phones: max 11 chars, must be approved (or
# pending) in the ClifeSMS console before messages can route.
CLIFESMS_SENDER_ID=Verunum
